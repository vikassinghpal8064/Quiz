# Neon Postgres pooled connection string (required)
DATABASE_URL=

# Session token signing key, must be at least 32 characters (required)
JWT_SECRET=

# Password reset emails via Resend (optional, reset flow is disabled without it)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL of the deployment, used to build password reset links
APP_URL=http://localhost:5173

# Allowed CORS origin for API calls, defaults to * when unset
ALLOW_ORIGIN=

# Supabase Storage for flash-card media (optional). Enables image / audio
# uploads; without all three the media endpoints answer 503 and the rest of the
# module works unchanged. The bucket must already exist and be public (its
# public URL is what blocks store and render), and the service-role key must
# never be exposed to the browser - only the server signs uploads with it.
# Copy the URL and service-role key from the Supabase project's API settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=flash-media
