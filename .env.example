# Neon Postgres pooled connection string (required)
DATABASE_URL=

# Session token signing key, must be at least 32 characters (required)
JWT_SECRET=

# Password reset emails via Resend (optional, reset flow is disabled without it)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL of the deployment, used to build password reset links
APP_URL=http://localhost:5173

# Allowed CORS origin for API calls, defaults to * when unset
ALLOW_ORIGIN=
