# Neon Postgres pooled connection string (required)
DATABASE_URL=

# Session token signing key, must be at least 32 characters (required)
JWT_SECRET=

# Password reset emails via Resend (optional, reset flow is disabled without it)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL of the deployment, used to build password reset links
APP_URL=http://localhost:5173

# Allowed CORS origin for API calls, defaults to * when unset
ALLOW_ORIGIN=

# Vercel Blob read/write token (optional). Enables image/audio uploads on flash
# cards; without it the media endpoints answer 503 and the rest of the module
# works unchanged. Copy it from the Vercel project's Blob store settings.
BLOB_READ_WRITE_TOKEN=
